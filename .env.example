# ⚠️ SECURITY WARNING: Never commit this file with real credentials!
# Copy this file to .env.local and fill in your actual values
# Add .env.local to .gitignore (already done)

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database Connection (for direct PostgreSQL connections if needed)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Admin Authentication
# ⚠️ CRITICAL: Use a strong password (min 16 chars, mixed case, numbers, symbols)
# Never use the default password 'heiwa_admin_2024'
ADMIN_PASSWORD=your_secure_admin_password_here

# Stripe Configuration (if using Stripe payments)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Email Configuration (Resend)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@your-domain.com

# Application Configuration
NEXT_PUBLIC_APP_URL=https://your-domain.com
NODE_ENV=production

# Netlify-specific (automatically set by Netlify)
# NETLIFY=true

