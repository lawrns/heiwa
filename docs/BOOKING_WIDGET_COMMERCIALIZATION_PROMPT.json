  "strategic_prompts": {
    "product_strategy": {
      "prompt": "You are a SaaS product strategist. Analyze the Heiwa booking widget and design a product strategy that can achieve $100M ARR in 5 years. Consider: 1) Market positioning against incumbents, 2) Product-led growth motions, 3) Platform expansion opportunities, 4) M&A landscape, 5) Exit strategies. Provide detailed quarterly roadmaps for the first 2 years.",
      "expected_output": {
        "market_analysis": "TAM, SAM, SOM calculations",
        "positioning": "Unique value proposition and messaging",
        "growth_model": "Viral coefficients, conversion rates, LTV/CAC",
        "roadmap": "Feature releases with success metrics",
        "financials": "Revenue projections and unit economics"
      }
    },
    "technical_architecture": {
      "prompt": "You are a principal architect designing a multi-tenant SaaS platform from the Heiwa widget. Design: 1) Tenant isolation strategy (database per tenant vs schema vs row-level), 2) Global deployment architecture (CDN, edge functions, data residency), 3) API gateway and rate limiting, 4) Plugin/app store architecture, 5) Event-driven architecture for integrations. Include diagrams, tech stack decisions, and migration paths.",
      "expected_output": {
        "architecture_diagrams": "System, data flow, deployment diagrams",
        "infrastructure": "Cloud setup, CI/CD, monitoring",
        "security": "Auth, encryption, compliance (SOC2, GDPR)",
        "scalability": "Horizontal scaling, caching strategies",
        "apis": "REST, GraphQL, webhook specifications"
      }
    },
    "developer_experience": {
      "prompt": "You are leading DX at a developer tool company. Design the world's best booking widget developer experience: 1) SDK design for 5+ frameworks, 2) Documentation that developers love, 3) Onboarding that converts in 5 minutes, 4) Debugging and monitoring tools, 5) Community building strategy. Include interactive examples, CLI tools, and VS Code extensions.",
      "expected_output": {
        "sdks": "TypeScript, Python, Ruby, PHP, Go client libraries",
        "documentation": "Interactive docs, API explorer, tutorials",
        "tools": "CLI, browser devtools, IDE extensions",
        "onboarding": "Interactive playground, quick starts",
        "community": "Discord, GitHub, meetups, contribution program"
      }
    },
    "go_to_market": {
      "prompt": "You are a CMO launching a new developer product. Create a comprehensive GTM strategy: 1) Product launch sequence (alpha, beta, GA), 2) Developer acquisition channels, 3) Content marketing strategy, 4) Partner ecosystem, 5) Pricing and packaging. Include specific tactics, budgets, and KPIs for each channel.",
